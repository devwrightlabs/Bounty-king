# ============================================================
#  Operation: Archipelago — Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to git.
# ============================================================

# ── Pi Network (Developer Portal → App → Keys) ─────────────
PI_API_KEY=your_pi_server_api_key_here

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgres://archipelago:password@localhost:5432/archipelago
PG_POOL_MAX=20
# Set to true when connecting to managed Postgres with TLS
PG_SSL=false

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────────────────
# Must be at least 32 random characters — use: openssl rand -hex 32
JWT_SECRET=replace_me_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ── Nakama ──────────────────────────────────────────────────
NAKAMA_URL=http://localhost:7350
# Set in Nakama config under runtime.http_key
NAKAMA_HTTP_KEY=your_nakama_runtime_http_key

# ── Internal service-to-service secret ─────────────────────
# Shared between Game API and Nakama module for dog-tag RPC calls
INTERNAL_SECRET=replace_me_with_a_shared_secret

# ── Economy ─────────────────────────────────────────────────
# How many game token micro-units to grant per 1 Pi spent
# 1000 means 1 Pi = 1000 tokens (each stored as 1_000_000 micro-units internally)
TOKEN_RATE_PER_PI=1000

# ── Game API ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
GAME_API_URL=http://localhost:3000
# Restrict CORS to your deployed frontend domain in production
ALLOWED_ORIGIN=*
